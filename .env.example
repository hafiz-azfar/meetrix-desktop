# The server reads this file. Keep provider credentials out of the frontend.
APP_ORIGIN=http://localhost:4317
HOST=127.0.0.1
PORT=4317
INSFORGE_URL=
INSFORGE_ANON_KEY=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DATABASE_PATH=./data/meetrix.sqlite
# Set NODE_ENV=production, an HTTPS APP_ORIGIN, WSS LiveKit URL and your InsForge project settings when hosting.
# TRUST_PROXY_HOPS=1

# Optional hosted cloud recording. LiveKit Egress must be running, able to reach
# the HTTPS APP_ORIGIN, and allowed to load its recording template. Use a
# private bucket and scope write/read permissions to meetrix-recordings/*.
# MEETRIX_CLOUD_RECORDING=true
# MEETRIX_EGRESS_S3_BUCKET=
# MEETRIX_EGRESS_S3_REGION=
# MEETRIX_EGRESS_S3_ACCESS_KEY=
# MEETRIX_EGRESS_S3_SECRET=
# MEETRIX_EGRESS_S3_ENDPOINT=
